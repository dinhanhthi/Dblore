// ViewModelTests.swift
// Template for testing NotebookViewModel logic
// Copy this to SQLNotebookTests/ folder after creating test target

import XCTest
@testable import SQLNotebook

final class ViewModelTests: XCTestCase {

    var viewModel: NotebookViewModel!
    var testNotebook: SQLNotebook!

    override func setUpWithError() throws {
        // Create a test notebook
        testNotebook = SQLNotebook(
            id: UUID(),
            metadata: NotebookMetadata(
                title: "Test Notebook",
                createdAt: Date(),
                modifiedAt: Date()
            ),
            cells: [
                NotebookCell(
                    id: UUID(),
                    type: .code,
                    content: "SELECT 1;",
                    result: nil,
                    executionCount: 0
                )
            ],
            connectionConfig: nil,
            settings: NotebookSettings()
        )

        // Create view model with test notebook
        viewModel = NotebookViewModel(notebook: testNotebook)
    }

    override func tearDownWithError() throws {
        viewModel = nil
        testNotebook = nil
    }

    // MARK: - Cell Management Tests

    func testAddCell() {
        // Arrange
        let initialCount = viewModel.notebook.cells.count

        // Act
        viewModel.addCell(type: .code, after: nil)

        // Assert
        XCTAssertEqual(viewModel.notebook.cells.count, initialCount + 1)
        XCTAssertEqual(viewModel.notebook.cells.last?.type, .code)
        XCTAssertEqual(viewModel.notebook.cells.last?.content, "")
    }

    func testAddCellAfterSpecificCell() {
        // Arrange
        let firstCellId = viewModel.notebook.cells[0].id
        viewModel.addCell(type: .code, after: nil) // Add a second cell
        let initialCount = viewModel.notebook.cells.count

        // Act
        viewModel.addCell(type: .code, after: firstCellId)

        // Assert
        XCTAssertEqual(viewModel.notebook.cells.count, initialCount + 1)
        // New cell should be at index 1 (right after first cell)
        XCTAssertEqual(viewModel.notebook.cells[1].type, .code)
    }

    func testDeleteCell() {
        // Arrange
        viewModel.addCell(type: .code, after: nil)
        viewModel.addCell(type: .code, after: nil)
        let cellToDelete = viewModel.notebook.cells[1].id
        let initialCount = viewModel.notebook.cells.count

        // Act
        viewModel.deleteCell(id: cellToDelete)

        // Assert
        XCTAssertEqual(viewModel.notebook.cells.count, initialCount - 1)
        XCTAssertFalse(viewModel.notebook.cells.contains(where: { $0.id == cellToDelete }))
    }

    func testDeleteNonExistentCell() {
        // Arrange
        let initialCount = viewModel.notebook.cells.count
        let nonExistentId = UUID()

        // Act
        viewModel.deleteCell(id: nonExistentId)

        // Assert
        // Should not crash and count should remain the same
        XCTAssertEqual(viewModel.notebook.cells.count, initialCount)
    }

    func testMoveCell() {
        // Arrange
        viewModel.addCell(type: .code, after: nil) // Cell 1
        viewModel.addCell(type: .code, after: nil) // Cell 2
        viewModel.notebook.cells[0].content = "First"
        viewModel.notebook.cells[1].content = "Second"
        viewModel.notebook.cells[2].content = "Third"

        // Act - Move first cell to last position
        viewModel.moveCell(from: IndexSet(integer: 0), to: 3)

        // Assert
        XCTAssertEqual(viewModel.notebook.cells.count, 3)
        XCTAssertEqual(viewModel.notebook.cells[0].content, "Second")
        XCTAssertEqual(viewModel.notebook.cells[1].content, "Third")
        XCTAssertEqual(viewModel.notebook.cells[2].content, "First")
    }

    // MARK: - Cell Selection Tests

    func testSelectCell() {
        // Arrange
        let cellId = viewModel.notebook.cells[0].id

        // Act
        viewModel.selectCell(id: cellId)

        // Assert
        XCTAssertEqual(viewModel.selectedCellId, cellId)
    }

    func testDeselectCell() {
        // Arrange
        let cellId = viewModel.notebook.cells[0].id
        viewModel.selectCell(id: cellId)
        XCTAssertNotNil(viewModel.selectedCellId)

        // Act
        viewModel.deselectCell()

        // Assert
        XCTAssertNil(viewModel.selectedCellId)
    }

    // MARK: - Clear Outputs Tests

    func testClearAllOutputs() {
        // Arrange - Add results to cells
        for i in 0..<viewModel.notebook.cells.count {
            viewModel.notebook.cells[i].result = CellResult(
                columns: [ColumnInfo(name: "id", type: "integer")],
                rows: [[.int(1)]],
                executionTime: 0.1,
                timestamp: Date(),
                error: nil
            )
            viewModel.notebook.cells[i].executionCount = 5
        }

        // Act
        viewModel.clearAllOutputs()

        // Assert
        for cell in viewModel.notebook.cells {
            XCTAssertNil(cell.result)
            XCTAssertEqual(cell.executionCount, 0)
        }
    }

    func testClearSingleCellOutput() {
        // Arrange
        let cellId = viewModel.notebook.cells[0].id
        viewModel.notebook.cells[0].result = CellResult(
            columns: [ColumnInfo(name: "id", type: "integer")],
            rows: [[.int(1)]],
            executionTime: 0.1,
            timestamp: Date(),
            error: nil
        )
        viewModel.notebook.cells[0].executionCount = 3

        // Act
        viewModel.clearCellOutput(id: cellId)

        // Assert
        XCTAssertNil(viewModel.notebook.cells[0].result)
        XCTAssertEqual(viewModel.notebook.cells[0].executionCount, 0)
    }

    // MARK: - Execution Count Tests

    func testIncrementExecutionCount() {
        // Arrange
        let cellId = viewModel.notebook.cells[0].id
        let initialCount = viewModel.notebook.cells[0].executionCount

        // Act
        viewModel.incrementExecutionCount(cellId: cellId)

        // Assert
        XCTAssertEqual(viewModel.notebook.cells[0].executionCount, initialCount + 1)
    }

    // MARK: - Running State Tests

    func testSetCellRunning() {
        // Arrange
        let cellId = viewModel.notebook.cells[0].id

        // Act
        viewModel.setCellRunning(cellId: cellId, isRunning: true)

        // Assert
        XCTAssertTrue(viewModel.runningCells.contains(cellId))
    }

    func testSetCellNotRunning() {
        // Arrange
        let cellId = viewModel.notebook.cells[0].id
        viewModel.setCellRunning(cellId: cellId, isRunning: true)

        // Act
        viewModel.setCellRunning(cellId: cellId, isRunning: false)

        // Assert
        XCTAssertFalse(viewModel.runningCells.contains(cellId))
    }

    func testIsCellRunning() {
        // Arrange
        let cellId = viewModel.notebook.cells[0].id

        // Assert - Initially not running
        XCTAssertFalse(viewModel.isCellRunning(cellId: cellId))

        // Act
        viewModel.setCellRunning(cellId: cellId, isRunning: true)

        // Assert - Now running
        XCTAssertTrue(viewModel.isCellRunning(cellId: cellId))
    }

    // MARK: - Sidebar Tests

    func testToggleRightSidebar() {
        // Arrange
        let initialState = viewModel.isRightSidebarVisible

        // Act
        viewModel.toggleRightSidebar()

        // Assert
        XCTAssertEqual(viewModel.isRightSidebarVisible, !initialState)

        // Act again
        viewModel.toggleRightSidebar()

        // Assert - Back to initial state
        XCTAssertEqual(viewModel.isRightSidebarVisible, initialState)
    }

    func testToggleLeftSidebar() {
        // Arrange
        let initialState = viewModel.isLeftSidebarVisible

        // Act
        viewModel.toggleLeftSidebar()

        // Assert
        XCTAssertEqual(viewModel.isLeftSidebarVisible, !initialState)
    }

    func testShowSidebarContent() {
        // Arrange
        let content = SidebarContent.connectionInfo

        // Act
        viewModel.showSidebarContent(content)

        // Assert
        XCTAssertTrue(viewModel.isRightSidebarVisible)
        XCTAssertEqual(viewModel.sidebarContent, content)
    }

    // MARK: - Connection State Tests

    func testConnectionStateInitiallyDisconnected() {
        XCTAssertEqual(viewModel.connectionState, .disconnected)
    }

    // MARK: - Notebook Metadata Tests

    func testNotebookMetadataAccessible() {
        XCTAssertEqual(viewModel.notebook.metadata.title, "Test Notebook")
        XCTAssertNotNil(viewModel.notebook.metadata.createdAt)
        XCTAssertNotNil(viewModel.notebook.metadata.modifiedAt)
    }

    func testNotebookSettings() {
        XCTAssertNotNil(viewModel.notebook.settings)
        XCTAssertGreaterThan(viewModel.notebook.settings.maxResultTableHeight, 0)
    }

    // MARK: - Cell Content Tests

    func testUpdateCellContent() {
        // Arrange
        let cellId = viewModel.notebook.cells[0].id
        let newContent = "SELECT * FROM users;"

        // Act
        if let index = viewModel.notebook.cells.firstIndex(where: { $0.id == cellId }) {
            viewModel.notebook.cells[index].content = newContent
        }

        // Assert
        XCTAssertEqual(viewModel.notebook.cells[0].content, newContent)
    }

    // MARK: - Multiple Cells Tests

    func testAddMultipleCells() {
        // Arrange
        let initialCount = viewModel.notebook.cells.count

        // Act
        for _ in 0..<10 {
            viewModel.addCell(type: .code, after: nil)
        }

        // Assert
        XCTAssertEqual(viewModel.notebook.cells.count, initialCount + 10)
    }

    func testDeleteAllCells() {
        // Arrange
        viewModel.addCell(type: .code, after: nil)
        viewModel.addCell(type: .code, after: nil)

        // Act
        let cellIds = viewModel.notebook.cells.map { $0.id }
        for cellId in cellIds {
            viewModel.deleteCell(id: cellId)
        }

        // Assert
        XCTAssertEqual(viewModel.notebook.cells.count, 0)
    }

    // MARK: - Edge Cases

    func testAddCellToEmptyNotebook() {
        // Arrange
        viewModel.notebook.cells = []

        // Act
        viewModel.addCell(type: .code, after: nil)

        // Assert
        XCTAssertEqual(viewModel.notebook.cells.count, 1)
    }

    func testSelectNonExistentCell() {
        // Arrange
        let nonExistentId = UUID()

        // Act
        viewModel.selectCell(id: nonExistentId)

        // Assert
        // Should not crash, selectedCellId will be set to non-existent id
        XCTAssertEqual(viewModel.selectedCellId, nonExistentId)
    }

    // MARK: - Performance Tests

    func testAddCellPerformance() {
        measure {
            for _ in 0..<100 {
                viewModel.addCell(type: .code, after: nil)
            }
        }
    }

    func testDeleteCellPerformance() {
        // Arrange - Create 100 cells
        for _ in 0..<100 {
            viewModel.addCell(type: .code, after: nil)
        }

        measure {
            let cellIds = viewModel.notebook.cells.map { $0.id }
            for cellId in cellIds {
                viewModel.deleteCell(id: cellId)
            }
        }
    }
}
