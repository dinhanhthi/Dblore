// SQLSyntaxHighlighterTests.swift
// Template for testing SQLSyntaxHighlighter utility
// Copy this to SQLNotebookTests/ folder after creating test target

import XCTest
@testable import SQLNotebook

final class SQLSyntaxHighlighterTests: XCTestCase {

    var highlighter: SQLSyntaxHighlighter!

    override func setUpWithError() throws {
        highlighter = SQLSyntaxHighlighter()
    }

    override func tearDownWithError() throws {
        highlighter = nil
    }

    // MARK: - Keyword Detection Tests

    func testKeywordHighlighting() {
        let sql = "SELECT * FROM users WHERE id = 1"
        let attributed = highlighter.highlight(sql)
        let string = String(attributed.characters)

        // Verify the string content is preserved
        XCTAssertEqual(string, sql)

        // Keywords should be detected (SELECT, FROM, WHERE)
        // Note: Actual color verification requires checking AttributedString attributes
        // For now, we just verify the string is preserved
    }

    func testKeywordsCaseInsensitive() {
        let sqlLower = "select * from users"
        let sqlUpper = "SELECT * FROM USERS"
        let sqlMixed = "SeLeCt * FrOm UsErS"

        let attributedLower = highlighter.highlight(sqlLower)
        let attributedUpper = highlighter.highlight(sqlUpper)
        let attributedMixed = highlighter.highlight(sqlMixed)

        // All should preserve original casing
        XCTAssertEqual(String(attributedLower.characters), sqlLower)
        XCTAssertEqual(String(attributedUpper.characters), sqlUpper)
        XCTAssertEqual(String(attributedMixed.characters), sqlMixed)
    }

    func testDDLKeywords() {
        let sql = "CREATE TABLE users (id INTEGER PRIMARY KEY)"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testDMLKeywords() {
        let sql = "INSERT INTO users (name) VALUES ('Alice')"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    // MARK: - Function Detection Tests

    func testFunctionHighlighting() {
        let sql = "SELECT COUNT(*) FROM users"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testMultipleFunctions() {
        let sql = "SELECT COUNT(*), MAX(age), MIN(age), AVG(salary) FROM employees"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testNestedFunctions() {
        let sql = "SELECT UPPER(TRIM(name)) FROM users"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    // MARK: - String Literal Tests

    func testSingleQuoteStrings() {
        let sql = "SELECT * FROM users WHERE name = 'Alice'"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testStringWithEscapedQuotes() {
        let sql = "SELECT 'O''Brien' AS name"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testMultipleStrings() {
        let sql = "INSERT INTO users (first, last) VALUES ('John', 'Doe')"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testDollarQuotedStrings() {
        let sql = "SELECT $$Hello 'World'$$ AS greeting"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    // MARK: - Number Tests

    func testIntegerNumbers() {
        let sql = "SELECT * FROM users WHERE age = 25"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testDecimalNumbers() {
        let sql = "SELECT * FROM products WHERE price = 19.99"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testNegativeNumbers() {
        let sql = "SELECT * FROM accounts WHERE balance < -100.50"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testScientificNotation() {
        let sql = "SELECT 1.5e10 AS big_number"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    // MARK: - Comment Tests

    func testSingleLineComment() {
        let sql = "SELECT * FROM users -- Get all users\nWHERE active = true"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testMultiLineComment() {
        let sql = """
        SELECT *
        /* This is a
           multi-line comment */
        FROM users
        """
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testNestedMultiLineComments() {
        let sql = "SELECT * /* outer /* inner */ outer */ FROM users"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    // MARK: - Operator Tests

    func testComparisonOperators() {
        let sql = "WHERE age >= 18 AND salary <= 100000"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testArithmeticOperators() {
        let sql = "SELECT price * quantity - discount AS total"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testLogicalOperators() {
        let sql = "WHERE active = true AND (role = 'admin' OR role = 'moderator')"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    // MARK: - Complex Query Tests

    func testComplexSelectQuery() {
        let sql = """
        SELECT
            u.id,
            u.name,
            COUNT(o.id) AS order_count,
            SUM(o.total) AS total_spent
        FROM users u
        LEFT JOIN orders o ON u.id = o.user_id
        WHERE u.created_at >= '2024-01-01'
        GROUP BY u.id, u.name
        HAVING COUNT(o.id) > 5
        ORDER BY total_spent DESC
        LIMIT 10
        """
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testCTEQuery() {
        let sql = """
        WITH active_users AS (
            SELECT * FROM users WHERE active = true
        )
        SELECT * FROM active_users
        WHERE created_at > NOW() - INTERVAL '30 days'
        """
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testSubquery() {
        let sql = """
        SELECT name
        FROM users
        WHERE id IN (
            SELECT user_id FROM orders
            WHERE total > 1000
        )
        """
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    // MARK: - Edge Cases

    func testEmptyString() {
        let sql = ""
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), "")
    }

    func testWhitespaceOnly() {
        let sql = "   \n\t  "
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testSingleKeyword() {
        let sql = "SELECT"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testUnicodeCharacters() {
        let sql = "SELECT '你好世界' AS greeting"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    // MARK: - PostgreSQL Specific Tests

    func testPostgreSQLDataTypes() {
        let sql = "CREATE TABLE test (id SERIAL, data JSONB, created TIMESTAMPTZ)"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testPostgreSQLCastOperator() {
        let sql = "SELECT '2024-01-01'::DATE AS start_date"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    func testPostgreSQLArrays() {
        let sql = "SELECT ARRAY[1, 2, 3] AS numbers"
        let attributed = highlighter.highlight(sql)

        XCTAssertEqual(String(attributed.characters), sql)
    }

    // MARK: - Performance Tests

    func testHighlightingPerformance() {
        let longSQL = String(repeating: "SELECT * FROM users WHERE id = 1; ", count: 100)

        measure {
            _ = highlighter.highlight(longSQL)
        }
    }

    func testHighlightingVeryLongQuery() {
        // Generate a very long SQL query
        var sql = "SELECT "
        for i in 0..<1000 {
            sql += "column_\(i), "
        }
        sql += "id FROM large_table"

        measure {
            _ = highlighter.highlight(sql)
        }
    }

    // MARK: - Tokenizer Tests (if tokenizer is exposed)

    // If SQLSyntaxHighlighter exposes a tokenize method, add tests for it
    // For example:
    /*
